VIDEOSDK_API_KEY=your_videosdk_api_key_here
VIDEOSDK_SECRET=your_videosdk_secret_here

# Multi-org: per-client keys live in orgs.json (managed at /admin). The two
# values above are the "default" org, used when a request has no org id.
# Org admin page — all three required, otherwise it does not exist (404).
# Page URL: http://<backend>/<ADMIN_PATH>/  — use a long random path, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_PATH=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: where the org registry is stored (default backend/orgs.json)
# ORGS_FILE=/path/to/orgs.json

# CORS: comma-separated exact origins. Allowed = ALLOWED_ORIGINS +
# FRONTEND_ORIGIN + each org's "Frontend origins" (admin page). "*" here, or
# nothing configured anywhere, allows every origin.
#   ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=
FRONTEND_ORIGIN=


# Flask server port (default 5000)
PORT=5000

# Set to 1 only for local dev — never in production
FLASK_DEBUG=0

# --- Muthoot Video PD (backend/muthoot, routes under /api/v1/muthoot) ---
# VideoSDK key/secret: the org below in orgs.json (admin page), not here.
MUTHOOT_ORG_ID=muthoot
# The deployed Zero Runtime agent (same VideoSDK account as the org's key)
MUTHOOT_ZERORUNTIME_AGENT_ID=
# The customer page's address; Video PD links are built on it
MUTHOOT_CLIENT_URL=
# Google Sheet with LOS / Results / Events tabs, shared with the service account
MUTHOOT_GOOGLE_SHEET_ID=
# Service account key file (relative paths are read from backend/)
MUTHOOT_GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional Drive folder of reference photos (shared with the service account)
MUTHOOT_GOOGLE_PHOTOS_FOLDER_ID=
MUTHOOT_LINK_VALID_HOURS=24
MUTHOOT_SELFIE_RETRY_MINUTES=30
# Link emails (Gmail: an App Password). Empty user: no emails are sent.
MUTHOOT_SMTP_HOST=smtp.gmail.com
MUTHOOT_SMTP_PORT=587
MUTHOOT_SMTP_USER=
MUTHOOT_SMTP_PASSWORD=
MUTHOOT_EMAIL_FROM=
MUTHOOT_EMAIL_FROM_NAME=Muthoot Finance Video PD
# Optional: where events, selfies and unsent results are written (default backend/muthoot/data)
# MUTHOOT_DATA_DIR=