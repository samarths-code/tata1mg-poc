# Backend env for the Video KYC (vkyc) flow.
# Copy to .env and fill in real values. NEVER commit .env to git.
# (PPMC / Google Sheet routes are disabled, so their env vars are not needed.)

# ── Required ──────────────────────────────────────────────────────────
# VideoSDK credentials — https://app.videosdk.live/api-keys
VIDEOSDK_API_KEY=your_videosdk_api_key_here
VIDEOSDK_SECRET=your_videosdk_secret_here

# ── Optional ──────────────────────────────────────────────────────────
# CORS allow-list. "*" allows any origin (dev). For production set a
# comma-separated list of exact origins, e.g.
#   ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Webhook URL for VideoSDK recording/session events. Leave unset to disable.
# VIDEOSDK_WEBHOOK_URL=https://your-backend.com/webhooks/videosdk

# Flask server port (default 5000)
PORT=5000

# Set to 1 only for local dev — never in production
FLASK_DEBUG=0
